<Window x:Class="ProjectFlowManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ProjectFlowManager.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Project Flow Manager" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <Border Grid.Row="0" Background="#FF1976D2" Padding="10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="White" FontSize="14" Margin="10">
                    <Run Text="Активные проекты:"/>
                    <Run Text="{Binding ActiveProjectsCount}" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Foreground="White" FontSize="14" Margin="20,10,10,10">
                    <Run Text="Просроченные задачи:"/>
                    <Run Text="{Binding OverdueTasksCount}" FontWeight="Bold"/>
                </TextBlock>
            </StackPanel>
        </Border>

       
        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="Проекты">
                <DataGrid x:Name="projectsGrid" ItemsSource="{Binding Projects}" 
                         AutoGenerateColumns="False" 
                         CanUserAddRows="False" 
                         SelectionMode="Single"
                         IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                        <DataGridTextColumn Header="Приоритет" Binding="{Binding Priority}" Width="80"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Прогресс" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text">
                                        <Setter.Value>
                                            <MultiBinding StringFormat="{}{0}%">
                                                <Binding Path="Progress" />
                                            </MultiBinding>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Все задачи">
                <DataGrid ItemsSource="{Binding AllTasks}" AutoGenerateColumns="False" 
                         CanUserAddRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Задача" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Проект" Binding="{Binding Projects.Name}" Width="150"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Сложность" Binding="{Binding Difficulty}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="Обновить" Command="{Binding LoadDataCommand}" 
                   Margin="5" Padding="10,5" MinWidth="100"/>
            <Button Content="Новый проект" Command="{Binding AddProjectCommand}" 
                   Margin="5" Padding="10,5" MinWidth="100"/>
            <Button Content="Добавить задачу" Command="{Binding AddTaskCommand}" 
                   Margin="5" Padding="10,5" MinWidth="100"/>
            <Button Content="Редактировать" 
                   Command="{Binding EditProjectCommand}" 
                   CommandParameter="{Binding ElementName=projectsGrid, Path=SelectedItem}"
                   Margin="5" Padding="10,5" MinWidth="100"/>
            <Button Content="Удалить" 
                   Command="{Binding DeleteProjectCommand}" 
                   CommandParameter="{Binding ElementName=projectsGrid, Path=SelectedItem}"
                   Margin="5" Padding="10,5" MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>