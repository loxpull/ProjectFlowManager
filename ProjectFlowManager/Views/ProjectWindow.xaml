<Window x:Class="ProjectFlowManager.Views.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ProjectFlowManager"
        Title="Управление проектом" Height="500" Width="800"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        
        <GroupBox Grid.Row="0" Header="Информация о проекте" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Название:" Grid.Row="0" Grid.Column="0" 
                          Margin="5" VerticalAlignment="Center"/>
                <TextBox x:Name="txtProjectName" Grid.Row="0" Grid.Column="1" 
                        Margin="5" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="Категория:" Grid.Row="0" Grid.Column="2" 
                          Margin="5" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="0" Grid.Column="3" Margin="5" 
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory}"/>

                <TextBlock Text="Приоритет:" Grid.Row="1" Grid.Column="0" 
                          Margin="5" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="5" 
                         ItemsSource="{Binding Priorities}"
                         SelectedItem="{Binding SelectedPriority}"/>

                <TextBlock Text="Статус:" Grid.Row="1" Grid.Column="2" 
                          Margin="5" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="3" Margin="5" 
                         ItemsSource="{Binding ProjectStatuses}"
                         SelectedItem="{Binding SelectedStatus}"/>

                <TextBlock Text="Описание:" Grid.Row="2" Grid.Column="0" 
                          Margin="5" VerticalAlignment="Top"/>
                <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" 
                        Margin="5" Height="60" TextWrapping="Wrap"
                        Text="{Binding ProjectDescription}"/>
            </Grid>
        </GroupBox>

        
        <GroupBox Grid.Row="1" Header="Прогресс" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <ProgressBar Value="{Binding ProjectProgress}" 
                            Minimum="0" Maximum="100" Width="200" Height="20"
                            Margin="10"/>
                <TextBlock Text="{Binding ProjectProgress, StringFormat={}{0}%}" 
                          VerticalAlignment="Center" Margin="10,0"/>
                <TextBlock Text="{Binding TasksSummary}" 
                          Margin="20,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </GroupBox>

        
        <GroupBox Grid.Row="2" Header="Задачи проекта" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="tasksGrid" Grid.Row="0" 
                         ItemsSource="{Binding Tasks}" 
                         AutoGenerateColumns="False" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Задача" Binding="{Binding Name}" Width="200"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                        <DataGridTextColumn Header="Сложность" Binding="{Binding Difficulty}" Width="80"/>
                        <DataGridTextColumn Header="Создана" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTextColumn Header="Дедлайн" Binding="{Binding TaskDeadline, StringFormat=dd.MM.yyyy}" Width="100"/>
                        <DataGridTemplateColumn Header="Действия" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Изм." Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.EditTaskCommand}"
                                                CommandParameter="{Binding}" Margin="2" Padding="5,2"/>
                                        <Button Content="Уд." Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}, Path=DataContext.DeleteTaskCommand}"
                                                CommandParameter="{Binding}" Margin="2" Padding="5,2"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                    <Button Content="Добавить задачу" Command="{Binding AddTaskToProjectCommand}"
                           Padding="10,5" Margin="5"/>
                    <Button Content="Обновить статусы" Command="{Binding UpdateTaskStatusesCommand}"
                           Padding="10,5" Margin="5"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" Width="100" Height="30" Margin="5" 
                   Command="{Binding SaveCommand}" IsDefault="True"/>
            <Button Content="Отмена" Width="100" Height="30" Margin="5" 
                   Command="{Binding CancelCommand}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>